; Leg UA -- the HOST SENDS.  Victor receives 32,768 bytes at 9600 as
; RCVUA.DAT.  Post-merge regression of the receive path: edits 17 (chk3),
; 18 (bulk ttinl) and 11 (DRPSIZ/DFWSIZ) all live on it.
set line /tmp/v9000
set speed 9600
set parity none
set carrier-watch off
set flow none
set receive timeout 20
set retry 30
log packets s16ayUA.pkt
send rcvua.dat
statistics
