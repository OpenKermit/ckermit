ECHO OFF
REM Leg SE (full caps, new caps binary, ends REMOTE EXIT) then leg SC (--safe-server).
IF EXIST STEPSE.OUT DEL STEPSE.OUT
IF EXIST STEPSC.OUT DEL STEPSC.OUT
IF EXIST SRVB.TXT DEL SRVB.TXT
IF EXIST SRVC.TXT DEL SRVC.TXT
IF EXIST SRVD.TXT DEL SRVD.TXT
IF EXIST PRTTEST.TXT DEL PRTTEST.TXT
IF EXIST MAILTEST.TXT DEL MAILTEST.TXT
IF EXIST SRVTMP\NUL RD SRVTMP
IF EXIST SRVTM\NUL RD SRVTM
CKSRV.EXE -l /dev/seriala -b 9600 -x > STEPSE.OUT
CKSRV.EXE -l /dev/seriala -b 9600 -x --safe-server > STEPSC.OUT
